secret_create=" python3 -c 'import secrets; print(secrets.token_hex())' "

DB_ECHO=1
DEBUG=1
PROJECT_NAME="Support"
VERSION="0.0.1"
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== POSTGRES DOCKER =====
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== AUTH =====
RESET_PASSWORD_TOKEN_SECRET="{secret_create}"
VERIFICATION_TOKEN_SECRET="{secret_create}"
JWT_SECRET="{secret_create}"
DEFAULT_EMAIL="{email}"
DEFAULT_PWD="{password}"
DEFAULT_TG_ID={your_tg_id}

# ===== BOT =====
TOKEN="{token}"
API_URL="{url}"


# ===== SMTP =====
SMTP_USER=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ===== CELERY =====
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_NUMBER_OF_WORKERS=1